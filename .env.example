# API: solo escucha en esta Mac, en http://127.0.0.1:8001
LOCAL_IA_PORT=8001
LOCAL_IA_MODE=managed
LOCAL_IA_BACKEND_PORT=8080
LOCAL_IA_MODEL=mlx-community/Qwen1.5-0.5B-Chat-4bit
# El instalador configura LOCAL_IA_MLX_PYTHON si encuentra MLX ya instalado.
# LOCAL_IA_MLX_PYTHON=/ruta/al/python/con/mlx
LOCAL_IA_IDLE_SECONDS=300
LOCAL_IA_DEFAULT_TOKENS=256
LOCAL_IA_MAX_TOKENS=1024
LOCAL_IA_MAX_INPUT_CHARS=12000
LOCAL_IA_MAX_QUEUE=8
LOCAL_IA_QUEUE_TIMEOUT=60
LOCAL_IA_STARTUP_TIMEOUT=90
LOCAL_IA_REQUEST_TIMEOUT=180
# 1: solo modelos en caché. 0: permite descargar el modelo al primer uso.
LOCAL_IA_OFFLINE=1
# En modo external no se inicia ni se detiene el servidor existente.
# LOCAL_IA_EXTERNAL_URL=http://127.0.0.1:8080
